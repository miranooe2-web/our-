{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "our-app",
  "main": "worker.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    // ⚠️️ ONE-SWAP RULE ⚠️⚠️
    // Replace PUT_ID_HERE with your Namespace ID.
    // Get it here: Cloudflare dashboard → Storage & Databases →
    // Key-Value → click "OURS_KV" → "Namespace ID" (the LONG string
    // with the copy button — NOT the name "OURS_KV").
    // Keep the quotation marks. Do not push until you've done this.
    {
      "binding": "OURS_KV",
      "id": "a7bf1004f87b4e448edd1eb81dd68db6"
    }
  ]
}
